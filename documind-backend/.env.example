# MongoDB — get a free cluster at https://www.mongodb.com/atlas
# Or use local MongoDB: mongodb://localhost:27017/documind
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/documind?retryWrites=true&w=majority

